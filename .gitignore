# ======================================================================
# IC3 HACKATHON .GITIGNORE
# Protects against large files, model weights, and sensitive cluster data
# ======================================================================

# 1. Project-Specific Output Folders
# Ignore everything inside these folders, but keep the folders themselves (optional)
/data/*
/logs/*
/checkpoints/*
/predictions/*
/audits/*

# (Optional) If you want Git to track the empty folders so they exist when cloned, 
# uncomment the lines below and put a blank .gitkeep file in each folder.
# !/data/.gitkeep
# !/logs/.gitkeep
# !/checkpoints/.gitkeep
# !/predictions/.gitkeep
# !/audits/.gitkeep

# 2. Machine Learning Weights & Models
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.onnx
*.msgpack
*.ckpt

# 3. Data & Output Files (Catch-all)
*.csv
*.jsonl
*.json
*.parquet
*.arrow
*.txt

# 4. SLURM & HiPerGator Artifacts
slurm-*.out
slurm-*.err
core.*

# 5. Python & Jupyter
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
profile_default/
ipython_config.py

# 6. Environments & Secrets
.env
.venv/
env/
venv/
ENV/
*.pem

# 7. OS Generated
.DS_Store
Thumbs.db